#!/usr/bin/python

import argparse
import os
import pathlib
import subprocess
import tempfile


def tmpfile(content: str) -> int:
    file, path = tempfile.mkstemp()
    os.unlink(path)
    os.write(file, content.encode())
    os.lseek(file, 0, os.SEEK_SET)
    return file


parser = argparse.ArgumentParser()
parser.add_argument("--no-workdir", action="store_true")
parser.add_argument("--bare-workdir", action="store_true")
parser.add_argument("--workdir-name")
(args, unknown_args) = parser.parse_known_args()

masked_paths_flags = []
# some default masked paths (taken from podman's source)
# https://github.com/podman-container-tools/container-libs/blob/fbbd878d826f4265ba5a8e28d496aa903814fe7a/common/pkg/config/default.go
for path in [
    "/proc/acpi",
    "/proc/kcore",
    "/proc/keys",
    "/proc/latency_stats",
    "/proc/sched_debug",
    "/proc/scsi",
    "/proc/timer_list",
    "/proc/timer_stats",
    "/proc/interrupts",
    # hide also the kernel cmdline for good measure
    "/proc/cmdline",
    # bwrap creates a process with PID=1 to reap child processes
    # prevent the sandbox from reading `cmdline` or `environ` from this process
    "/proc/1",
]:
    path_obj = pathlib.Path(path)
    if path_obj.is_file():
        masked_paths_flags.extend(
            (
                *["--dev-bind", "/dev/null", path],
                *["--remount-ro", path],
            )
        )
    elif path_obj.is_dir():
        masked_paths_flags.extend(
            [
                *["--tmpfs", path],
                *["--remount-ro", path],
            ]
        )

uid = os.getuid()
gid = os.getgid()
home = os.path.expanduser("~")
cwd = os.getcwd()
editor = os.environ.get("EDITOR")
assert editor is not None
term = os.environ.get("TERM")
assert term is not None
rundir = os.environ.get("XDG_RUNTIME_DIR")
assert rundir is not None

pi_user = "pi"
pi_group = "pi"
pi_hostname = "sandbox"
pi_uid = 1000
pi_gid = 1000
pi_hostaddr_ipv4 = "169.254.17.1"
pi_hostaddr_ipv6 = "fe80::17:1"
pi_dns = "169.254.17.2"
pi_home = os.path.join("/home", pi_user)
pi_rundir = os.path.join("/run/user", str(pi_uid))

etc_passwd_fd = tmpfile(f"""\
{pi_user}:x:{pi_uid}:{pi_gid}::{pi_home}:/usr/bin/bash
nobody:x:65534:65534::/:/usr/bin/nologin
""")

etc_group_fd = tmpfile(f"""\
{pi_group}:x:{pi_gid}:
nobody:x:65534:
""")

etc_hosts_fd = tmpfile(f"""\
127.0.0.1           localhost
::1                 localhost
{pi_hostaddr_ipv4}  host.internal
{pi_hostaddr_ipv6}  host.internal
""")

etc_resolv_conf_fd = tmpfile(f"""\
nameserver {pi_dns}
""")

if args.no_workdir:
    workdir_flags = [
        *["--chdir", pi_home],
    ]
elif args.bare_workdir:
    workdir = os.path.join(pi_home, "workdir")
    workdir_flags = [
        *["--bind", cwd, workdir],
        *["--chdir", workdir],
    ]
else:
    if args.workdir_name:
        workdir = os.path.join(pi_home, "workdir", args.workdir_name)
    else:
        workdir = os.path.join(pi_home, "workdir", os.path.basename(cwd))
    workdir_flags = [
        *["--bind", cwd, workdir],
        *["--chdir", workdir],
    ]

os.makedirs(os.path.join(rundir, "zmy-pi"), exist_ok=True)


unshare_block = os.pipe()
namespace_block = os.pipe()

pid = os.getpid()

if os.fork() == 0:
    os.close(unshare_block[1])
    os.close(namespace_block[0])

    os.read(unshare_block[0], 1)

    # we do also a single map in the subuid/subgid range in order
    # for `newgidmap` not to write "deny" to `/proc/$pid/setgroups`
    subprocess.run(
        ["newuidmap", str(pid), "0", str(uid), "1", str(uid), "100000", "1"],
        check=True,
    )
    subprocess.run(
        ["newgidmap", str(pid), "0", str(gid), "1", str(gid), "100000", "1"],
        check=True,
    )

    os.close(namespace_block[1])

    subprocess.run(
        [
            "pasta",
            "--quiet",
            "--config-net",
            *["-t", "none"],
            *["-u", "none"],
            *["-T", "none"],
            *["-U", "none"],
            *["--map-host-loopback", "none"],
            *["--map-guest-addr", pi_hostaddr_ipv4],
            *["--map-guest-addr", pi_hostaddr_ipv6],
            *["--dns-forward", pi_dns],
            str(pid),
        ],
        check=False,
    )

else:
    os.close(unshare_block[0])
    os.close(namespace_block[1])

    os.unshare(os.CLONE_NEWUSER | os.CLONE_NEWNET)

    os.close(unshare_block[1])

    os.read(namespace_block[0], 1)

    os.write(os.open("/proc/sys/net/ipv4/ping_group_range", os.O_WRONLY), b"0 0")

    os.setgroups([0])

    os.set_inheritable(etc_passwd_fd, True)
    os.set_inheritable(etc_group_fd, True)
    os.set_inheritable(etc_hosts_fd, True)
    os.set_inheritable(etc_resolv_conf_fd, True)

    # call bwrap
    os.execvp(
        "bwrap",
        [
            "bwrap",
            #
            "--die-with-parent",
            "--unshare-all",
            "--unshare-user",
            "--disable-userns",
            "--share-net",
            #
            *["--dev", "/dev"],
            *["--proc", "/proc"],
            *["--tmpfs", pi_rundir],
            *["--tmpfs", "/tmp"],
            #
            *masked_paths_flags,
            #
            *["--ro-bind", "/usr/bin", "/usr/bin"],
            *["--ro-bind", "/usr/lib", "/usr/lib"],
            *["--ro-bind", "/usr/share", "/usr/share"],
            *["--ro-bind", "/usr/include", "/usr/include"],
            *["--symlink", "usr/lib", "/lib64"],
            *["--symlink", "usr/bin", "/bin"],
            #
            *["--file", str(etc_passwd_fd), "/etc/passwd"],
            *["--file", str(etc_group_fd), "/etc/group"],
            *["--file", str(etc_hosts_fd), "/etc/hosts"],
            *["--file", str(etc_resolv_conf_fd), "/etc/resolv.conf"],
            *["--ro-bind", "/etc/ca-certificates", "/etc/ca-certificates"],
            *["--ro-bind", "/etc/ssl", "/etc/ssl"],
            #
            *["--bind", os.path.join(home, ".local/pi"), pi_home],
            #
            *["--remount-ro", "/"],
            #
            *["--cap-drop", "ALL"],
            *["--uid", str(pi_uid)],
            *["--gid", str(pi_gid)],
            *["--hostname", pi_hostname],
            #
            "--clearenv",
            *["--setenv", "HOME", pi_home],
            *[
                "--setenv",
                "PATH",
                ":".join(
                    [
                        os.path.join(pi_home, ".local/bin"),
                        os.path.join(pi_home, ".npm/bin"),
                        "/usr/bin",
                        "/usr/lib/rustup/bin",
                    ]
                ),
            ],
            *["--setenv", "EDITOR", editor],
            *["--setenv", "TERM", term],
            *["--setenv", "XDG_RUNTIME_DIR", pi_rundir],
            #
            *[
                "--ro-bind",
                os.path.join(home, ".rustup"),
                os.path.join(pi_home, ".rustup"),
            ],
            *[
                "--ro-bind",
                os.path.join(home, ".cargo/config.toml"),
                os.path.join(pi_home, ".cargo/config.toml"),
            ],
            #
            *[
                "--ro-bind",
                os.path.join(home, ".local/bin/zmy"),
                os.path.join(pi_home, ".local/bin/zmy"),
            ],
            *["--bind", os.path.join(rundir, "zmy-pi"), os.path.join(pi_rundir, "zmy")],
            #
            *workdir_flags,
            #
            *(unknown_args if len(unknown_args) > 0 else ["pi"]),
        ],
    )
